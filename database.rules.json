{
  "rules": {
    ".read": false,
    ".write": false,

    "aircraft": {
      ".read": true,

      "$tail": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "completionDate":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "completionLocation": { ".validate": "newData.isString() && newData.val().matches(/^(Jeddah|Riyadh)$/)" },
        "iphoStatus":         { ".validate": "newData.isString() && newData.val() === 'completed'" },
        "mg101Status":        { ".validate": "newData.isString() && newData.val().matches(/^(provisioned|done)$/)" },
        "beamcfgStatus":      { ".validate": "newData.isString() && newData.val().matches(/^(pending|done)$/)" },
        "note":               { ".validate": "newData.isString() && newData.val().length <= 500" },
        "swVersion":          { ".validate": "newData.isString() && newData.val().matches(/^[0-9]+\\.[0-9]+\\.[0-9]+$/)" },

        "retrofitLocation":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "retrofitStart":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "retrofitEnd":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "wifiVisibility":     { ".validate": "newData.isString() && newData.val().matches(/^(public|hidden)$/)" },
        "activatedDate":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "simRoaming":         { ".validate": "newData.isString() && newData.val().matches(/^(active|inactive)$/)" },

        "ugoVersion":         { ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z][0-9A-Za-z.-]{0,19}$/)" },
        "tilesVersion":       { ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z][0-9A-Za-z.-]{0,19}$/)" },

        "maintenance": {
          "open":      { ".validate": "newData.isBoolean()" },
          "reason":    { ".validate": "newData.isString() && newData.val().length <= 500" },
          "flaggedAt": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
          "$other":    { ".validate": false }
        },

        "modem": {
          "taurus": {
            "commissionedDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
            "mgId":             { ".validate": "newData.isString() && newData.val().length <= 40" },
            "tid":              { ".validate": "newData.isString() && newData.val().length <= 40" },
            "se4":              { ".validate": "newData.isString() && newData.val().length <= 40" },
            "se2c":             { ".validate": "newData.isString() && newData.val().length <= 40" },
            "notes":            { ".validate": "newData.isString() && newData.val().length <= 500" },
            "$other":           { ".validate": false }
          },
          "hughes": {
            "commissionedDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
            "chassisId":        { ".validate": "newData.isString() && newData.val().length <= 40" },
            "esn":              { ".validate": "newData.isString() && newData.val().length <= 40" },
            "notes":            { ".validate": "newData.isString() && newData.val().length <= 500" },
            "$other":           { ".validate": false }
          },
          "$other":           { ".validate": false }
        },

        "media": {
          "mediaCycle":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
          "mediaDisplay":  { ".validate": "newData.isString() && newData.val().length <= 32" },
          "mediaSource":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "loadedDateUTC": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
          "comments":      { ".validate": "newData.isString() && newData.val().length <= 500" },
          "$other":        { ".validate": false }
        },

        "$other":             { ".validate": false }
      }
    },

    "fleet": {
      ".read": true,

      "$tail": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "type":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "station":     { ".validate": "newData.isString() && newData.val().length <= 10" },
        "fit":         { ".validate": "newData.isString() && newData.val().matches(/^(linefit|retrofit)$/)" },
        "fleetStatus": { ".validate": "newData.isString() && newData.val().matches(/^(Planned|In Retrofit|Installed|Commissioned|Active|Decommissioned)$/)" },
        "comments":    { ".validate": "newData.isString() && newData.val().length <= 500" },

        "$other":      { ".validate": false }
      }
    },

    "schedule": {
      ".read": true,

      "$entry": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "aircraft":    { ".validate": "newData.isString() && newData.val().length <= 12" },
        "date":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "time":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
        "workpackage": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "wo_flags":    { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9 \\/+_-]{0,32}$/)" },
        "station":     { ".validate": "newData.isString() && newData.val().matches(/^(JED|RUH)$/)" },
        "status":      { ".validate": "newData.isString() && newData.val().matches(/^(scheduled|in-progress|completed|postponed)$/)" },

        "$other":      { ".validate": false }
      }
    },

    "activities": {
      ".read": true,

      "$id": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "aircraft": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "date":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "category": { ".validate": "newData.isString() && newData.val().matches(/^(hardware_rr|software_update|modem_commissioning|troubleshooting|maintenance|configuration|inspection|modification|other)$/)" },
        "title":    { ".validate": "newData.isString() && newData.val().length <= 120" },
        "task":     { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "outcome":  { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "notes":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "loggedAt": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },

        "details": {
          "partReplaced":        { ".validate": "newData.isString() && newData.val().length <= 120" },
          "lruId":               { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)" },
          "position":            { ".validate": "newData.isString() && newData.val().length <= 20" },
          "partNumber":          { ".validate": "newData.isString() && newData.val().length <= 60" },
          "oldPart":             { ".validate": "newData.isString() && newData.val().length <= 60" },
          "newPart":             { ".validate": "newData.isString() && newData.val().length <= 60" },
          "softwareName":        { ".validate": "newData.isString() && newData.val().length <= 120" },
          "version":             { ".validate": "newData.isString() && newData.val().length <= 40" },
          "modemType":           { ".validate": "newData.isString() && newData.val().length <= 60" },
          "commissioningResult": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "removalReason":       { ".validate": "newData.isString() && newData.val().length <= 200" },
          "shopStatus":          { ".validate": "newData.isString() && newData.val().matches(/^(pending|in_shop|repaired|scrap|no_fault)$/)" },
          "shopRef":             { ".validate": "newData.isString() && newData.val().length <= 60" },
          "shopFinding":         { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "recordType":          { ".validate": "newData.isString() && newData.val().matches(/^(baseline)$/)" },
          "$other":              { ".validate": false }
        },

        "$other":   { ".validate": false }
      }
    },

    "hardware": {
      ".read": true,

      "$lru": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "swVersion":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "partNumber": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "vendor":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "notes":      { ".validate": "newData.isString() && newData.val().length <= 1000" },

        "issues": {
          "$issue": {
            "title":      { ".validate": "newData.isString() && newData.val().length <= 120" },
            "detail":     { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "rootCause":  { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "resolution": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "status":     { ".validate": "newData.isString() && newData.val().matches(/^(open|resolved)$/)" },
            "loggedAt":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
            "$other":     { ".validate": false }
          }
        },

        "$other":     { ".validate": false }
      }
    },

    "units": {
      ".read": true,

      "$unit": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "lruId":         { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,40}$/)" },
        "serial":        { ".validate": "newData.isString() && newData.val().length <= 60" },
        "roaming":       { ".validate": "newData.isString() && newData.val().matches(/^(global|local)$/)" },
        "lifecycle":     { ".validate": "newData.isString() && newData.val().matches(/^(retired)$/)" },

        "partNumber":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "altPartNumber": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "altSerial":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "revision":      { ".validate": "newData.isString() && newData.val().length <= 40" },
        "modDots":       { ".validate": "newData.isString() && newData.val().length <= 120" },
        "vendor":        { ".validate": "newData.isString() && newData.val().length <= 60" },
        "notes":         { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "addedAt":       { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },

        "fitments": {
          "$fitment": {
            "aircraft":      { ".validate": "newData.isString() && newData.val().length <= 12" },
            "position":      { ".validate": "newData.isString() && newData.val().length <= 20" },
            "state":         { ".validate": "newData.isString() && newData.val().matches(/^(on_wing|removed)$/)" },
            "condition":     { ".validate": "newData.isString() && newData.val().matches(/^(fault)$/)" },
            "roaming":       { ".validate": "newData.isString() && newData.val().matches(/^(global|local)$/)" },
            "outputDbm":     { ".validate": "newData.isString() && newData.val().matches(/^-?[0-9]{1,3}([.][0-9]{1,2})?$/)" },
            "fittedDate":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
            "removedDate":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
            "removalReason": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "shopStatus":    { ".validate": "newData.isString() && newData.val().matches(/^(pending|in_shop|repaired|scrap|no_fault)$/)" },
            "shopRef":       { ".validate": "newData.isString() && newData.val().length <= 60" },
            "shopFinding":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "activityId":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "notes":         { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "loggedAt":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
            "$other":        { ".validate": false }
          }
        },

        "$other":        { ".validate": false }
      }
    },

    "visits": {
      ".read": true,

      "total": {
        ".write": "newData.exists() && newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
      },

      "daily": {
        "$day": {
          ".write": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.exists() && newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
        }
      },

      "$other": { ".write": false }
    },

    "editors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
