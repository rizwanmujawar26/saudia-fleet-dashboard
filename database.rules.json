{
  "rules": {
    ".read": false,
    ".write": false,

    "aircraft": {
      ".read": true,

      "$tail": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "completionDate":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "completionLocation": { ".validate": "newData.isString() && newData.val().matches(/^(Jeddah|Riyadh)$/)" },
        "iphoStatus":         { ".validate": "newData.isString() && newData.val() === 'completed'" },
        "mg101Status":        { ".validate": "newData.isString() && newData.val().matches(/^(provisioned|done)$/)" },
        "beamcfgStatus":      { ".validate": "newData.isString() && newData.val().matches(/^(pending|done)$/)" },
        "note":               { ".validate": "newData.isString() && newData.val().length <= 500" },
        "swVersion":          { ".validate": "newData.isString() && newData.val().matches(/^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$/)" },

        "maintenance": {
          "open":      { ".validate": "newData.isBoolean()" },
          "reason":    { ".validate": "newData.isString() && newData.val().length <= 500" },
          "flaggedAt": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
          "$other":    { ".validate": false }
        },

        "media": {
          "mediaCycle":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
          "mediaDisplay":  { ".validate": "newData.isString() && newData.val().length <= 32" },
          "mediaSource":   { ".validate": "newData.isString() && newData.val().length <= 64" },
          "loadedDateUTC": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/)" },
          "comments":      { ".validate": "newData.isString() && newData.val().length <= 500" },
          "$other":        { ".validate": false }
        },

        "$other":             { ".validate": false }
      }
    },

    "fleet": {
      ".read": true,

      "$tail": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "type":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "station":     { ".validate": "newData.isString() && newData.val().length <= 10" },
        "fit":         { ".validate": "newData.isString() && newData.val().matches(/^(linefit|retrofit)$/)" },
        "fleetStatus": { ".validate": "newData.isString() && newData.val().matches(/^(active|stored|retired)$/)" },
        "comments":    { ".validate": "newData.isString() && newData.val().length <= 500" },

        "$other":      { ".validate": false }
      }
    },

    "schedule": {
      ".read": true,

      "$entry": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",

        "aircraft":    { ".validate": "newData.isString() && newData.val().length <= 12" },
        "date":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$/)" },
        "time":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
        "workpackage": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "wo_flags":    { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9 \\\\/+_-]{0,32}$/)" },
        "station":     { ".validate": "newData.isString() && newData.val().matches(/^(JED|RUH)$/)" },
        "status":      { ".validate": "newData.isString() && newData.val().matches(/^(scheduled|in-progress|completed|postponed)$/)" },

        "$other":      { ".validate": false }
      }
    },

    "editors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
